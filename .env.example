DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
JWT_SECRET_KEY=change-me-to-a-long-random-string
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1
GCS_TRANSCRIBE_BUCKET=your-transcribe-bucket-name

# Optional: the app runs fully without RESEND_API_KEY (the client invite link is
# returned directly instead of emailed); set FRONTEND_BASE_URL to the real deployed
# frontend URL in any non-local environment, since it's used to build invite links.
RESEND_API_KEY=
FRONTEND_BASE_URL=http://localhost:3000
